# ==============================================================================
# IQA-RAG Environment Variables & API Key Configuration
# Copy this file to .env and fill in your active API keys
# ==============================================================================

# LLM Providers (Google Gemini or OpenAI)
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Default Provider & Models
LLM_PROVIDER=gemini                     # Options: 'gemini', 'openai', 'fallback'
LLM_MODEL=gemini-1.5-flash             # e.g., 'gemini-1.5-flash', 'gpt-4o-mini'
EMBEDDING_PROVIDER=local               # Options: 'local', 'gemini', 'openai'
EMBEDDING_MODEL=all-MiniLM-L6-v2       # or 'text-embedding-004', 'text-embedding-3-small'

# Vector Store Configuration
VECTORSTORE_DIR=./data/vectorstore
COLLECTION_NAME=iqa_literature

# Pipeline Retrieval & Chunking Defaults
CHUNK_SIZE=300                         # Characters or tokens per chunk
CHUNK_OVERLAP=50
RETRIEVAL_TOP_K=5
TEMPERATURE=0.2
